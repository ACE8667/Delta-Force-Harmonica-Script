{
  "name": "note-guide",
  "version": "1.1.1",
  "private": true,
  "description": "八音阶音符指引桌面程序",
  "main": "desktop/main.cjs",
  "scripts": {
    "start:desktop": "electron .",
    "package:desktop": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ace8667.note-guide",
    "productName": "音符指引",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "produce/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
